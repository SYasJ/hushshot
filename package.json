{
  "name": "redactit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, offline screenshot & PDF redaction tool. Auto-blurs credit cards, SSNs, emails, phones, addresses, API keys, faces & QR codes and strips EXIF/GPS metadata — 100% in your browser.",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/copy-assets.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/copy-assets.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "e2e": "node e2e/smoke.mjs",
    "samples": "node scripts/make-samples.mjs",
    "desktop": "npm run build && npx electron desktop/main.cjs",
    "desktop:pack": "npm run build && npx electron-builder --config desktop/electron-builder.yml",
    "examples": "node scripts/make-examples.mjs",
    "examples:inputs": "node scripts/make-example-inputs.mjs"
  },
  "devDependencies": {
    "jsbarcode": "^3.12.3",
    "playwright": "^1.63.0",
    "qrcode": "^1.5.4",
    "vite": "^6.4.3",
    "wait-on": "^9.4.0"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@vladmandic/face-api": "^1.7.15",
    "@zxing/library": "^0.21.3",
    "exifr": "^7.1.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^5.1.1"
  },
  "keywords": [
    "privacy",
    "redaction",
    "redact",
    "screenshot",
    "pdf",
    "ocr",
    "pii",
    "exif",
    "gps",
    "metadata",
    "blur",
    "face-blur",
    "anonymize",
    "local-first",
    "offline"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SYasJ/redactit.git"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://syasj.github.io/redactit/",
  "bugs": {
    "url": "https://github.com/SYasJ/redactit/issues"
  }
}
